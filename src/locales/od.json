    "features": {
      "weather": "\u0B06\u0B2A\u0B23\u0B3E \u0B38\u0D4D\u0D25\u0BBE\u0BA8\u0B40\u0B2F \u0B2A\u0BBE\u0B17",
      "weatherDesc": "Open-Meteo \u0B30\u0BC1 \u0B38\u0D4D\u0D25\u0BBE\u0BA8\u0B40\u0B2F \u0B2A\u0BBE\u0B17 \u0B2A\u0BC2\u0B30\u0D4D\u0D2C\u0BBE\u0BA8\u0D41\u0B2E\u0BBE\u0B28 \u0B0F\u0B2C\u0B02 \u0B2C\u0BB0\u0D4D\u0D37\u0BBE \u0D9F\u0D4D\u0D30\u0BBE\u0D15\u0BBF\u0D02\u0D17",
      "advisory": "\u0B2B\u0B38\u0B32 \u0B38\u0D4D\u0D1F\u0D30 \u0B2A\u0B30\u0B3E\u0B2E\u0B30\u0B4D\u0B36",
      "advisoryDesc": "\u0B06\u0B2A\u0B23\u0BBE \u0B2B\u0B38\u0B32, \u0B24\u0BBE\u0B39\u0BBE\u0B30 \u0B38\u0D4D\u0D1F\u0D30 \u0B0F\u0B2C\u0B02 \u0B2A\u0BBE\u0B17 \u0B05\u0B2C\u0B38\u0D4D\u0D25\u0BBF\u0D24\u0BBE \u0B05\u0B28\u0D41\u0B38\u0BBE\u0B30\u0D3F\u0D24 \u0B38\u0B41\u0B2A\u0BBE\u0B30\u0BFF\u0B36",
      "market": "\u0B2C\u0B3E\u0B1C\u0BBE\u0B30 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F \u0D24\u0BC1\u0B33\u0BB2\u0BBE",
      "marketDesc": "\u0B35\u0BBF\u0B15\u0BCD\u0B30\u0BFF\u0B2F \u0B2A\u0BBE\u0B30\u0D4D\u0D35 \u0B38\u0BC7 \u0B38\u0BB0\u0D4D\u0D2C\u0B4B\u0D24\u0D4D\u0D24\u0B2E \u0B2E\u0BC2\u0B32\u0D4D\u0D2F \u0B2A\u0BBE\u0B39\u0BF3\u0D3F\u0B2C\u0BBE\u0D28\u0D4D\u0D24\u0D41",
      "risk": "\u0B38\u0B02\u0B15\u0B1F \u0B2A\u0BCD\u0B30\u0B3E\u0B30\u0B2E\u0D4D\u0D2D \u0B38\u0B24\u0B30\u0D4D\u0B15\u0B24\u0B3E",
      "riskDesc": "\u0B2C\u0BB0\u0D4D\u0D37\u0BBE, \u0B2C\u0B3E\u0B1C\u0BBE\u0B30 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F \u0B0F\u0B2C\u0B02 \u0B2A\u0B03\u0B21 \u0B38\u0D4D\u0D25\u0BFF\u0D24\u0B3F \u0B09\u0B2A\u0BB0 \u0B05\u0B27\u0BBE\u0B30\u0BFF\u0D24 \u0B38\u0D4D\u0D39\u0B1A\u0D4D\u0D1A \u0B2C\u0BFF\u0B2A\u0B26 \u0B38\u0D4D\u0D15\u0B4B\u0B30\u0BFF\u0D02\u0D17"
    },
    "howItWorks": {
      "title": "\u0B0F\u0B39\u0BBE \u0B15\u0BFF\u0B2A\u0B30\u0BFF \u0B15\u0BBE\u0B2E \u0B15\u0BB0\u0BC7",
      "step1": "\u0B06\u0B2A\u0B23\u0BBE \u0B16\u0BC7\u0D24 \u0B38\u0B47\u0D1F\u0D4D \u0B15\u0BB0\u0BA8\u0D4D\u0D24\u0D41",
      "step1Desc": "\u0B06\u0B2A\u0B23\u0BBE \u0B38\u0D4D\u0D25\u0BBE\u0BA8, \u0B2B\u0B38\u0B32 \u0B0F\u0B2C\u0B02 \u0B2E\u0BCC\u0B33\u0BFF\u0B15 \u0B16\u0BC7\u0D24 \u0B2C\u0BFF\u0B2C\u0BB0\u0D4D\u0D23\u0B40 \u0B2A\u0BCD\u0B30\u0B35\u0BC7\u0B36 \u0B15\u0BB0\u0BA8\u0D4D\u0D24\u0D41",
      "step2": "\u0B26\u0BC8\u0BA8\u0BFF\u0B15 \u0B2A\u0B30\u0B3E\u0B2E\u0B30\u0B4D\u0B36 \u0B2A\u0BBE\u0B07\u0B1A\u0D4D\u0D24\u0D41",
      "step2Desc": "\u0B2A\u0BBE\u0B17-\u0B38\u0B1A\u0BC7\u0D24\u0BA8, \u0B2B\u0B38\u0B32-\u0B35\u0BFF\u0B36\u0BFF\u0D37\u0D4D\u0D1F \u0B38\u0BC1\u0B2A\u0BBE\u0B30\u0BFF\u0B36 \u0B2A\u0BCD\u0B30\u0BBE\u0B2A\u0D4D\u0D24 \u0B15\u0BB0\u0BA8\u0D4D\u0D24\u0D41",
      "step3": "\u0B2C\u0B3E\u0B1C\u0BBE\u0B30 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F \u0D9F\u0D4D\u0D30\u0BBE\u0D15\u0BBF\u0D02\u0D17 \u0B15\u0BB0\u0BA8\u0D4D\u0D24\u0D41",
      "step3Desc": "\u0B35\u0BBF\u0B15\u0BCD\u0B30\u0BFF\u0B2F \u0B2A\u0BBE\u0B30\u0D4D\u0D35 \u0B38\u0BC7 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F \u0B24\u0BC1\u0B33\u0BB2\u0BBE \u0B15\u0BB0\u0BA8\u0D4D\u0D24\u0D41",
      "step4": "\u0B05\u0D24\u0BBF\u0B30\u0BFF\u0B15\u0D4D\u0D37\u0BBE \u0B38\u0D4D\u0D1F\u0D3F\u0D24 \u0B30\u0BC1\u0B39\u0BBE\u0D28\u0D4D\u0D24\u0D41",
      "step4Desc": "\u0B38\u0B3E\u0B25\u0B3F\u0B2F\u0B2E\u0BBE\u0D28 \u0B38\u0B24\u0B30\u0D4D\u0B15\u0B24\u0B3E \u0B38\u0BFF\u0D37\u0D4D\u0D1F\u0D3F\u0D2E \u0B06\u0B30\u0D4D\u0D25\u0BFF\u0B15 \u0B2C\u0BFF\u0B2A\u0B26 \u0B1A\u0BFF\u0B39\u0D4D\u0D1F\u0B3F\u0D1F \u0B15\u0BB0\u0BC7",
      "disclaimer": "\u0B15\u0BC3\u0B37\u0B3F \u0B38\u0B3E\u0B25\u0B40 \u0B15\u0BC3\u0B37\u0B3F \u0B28\u0BFF\u0B30\u0D4D\u0D23\u0BAF \u0B38\u0B39\u0B3E\u0B2F\u0B24\u0B3E \u0B2A\u0BBE\u0B39\u0BF3\u0D3F\u0B2F\u0BBE \u0B2F\u0B4B\u0B1C\u0BBE\u0B28\u0BBE \u0B2A\u0D4D\u0D30\u0B4B\u0D1F\u0D4B\u0D1F\u0BBE\u0D07\u0B2A\u0D4D\u0D2E\u0BCD \u0B05\u0B28\u0D4D\u0D24\u0B30\u0B3E\u0B17\u0D24 \u0B2E\u0D3E\u0D27\u0D4D\u0D2F\u0D02 \u0B38\u0B39\u0B3E\u0B2F\u0B24\u0B3E \u0B0F\u0B39\u0BBE \u0B1A\u0BFF\u0B15\u0BFF\u0D24\u0D4D\u0D38\u0BBE \u0B2C\u0BBE \u0B2E\u0BBE\u0BA8\u0B38\u0BFF\u0B15 \u0B30\u0D4B\u0D17 \u0B28\u0BFF\u0B30\u0D4D\u0D23\u0BAF \u0B2A\u0BCD\u0B30\u0B26\u0BBE\u0BA8 \u0B15\u0BB0\u0BC7 \u0BA8\u0BBE\u0B39\u0BFF\u0D1E\u0BCD",
      "dataNote": "\u0B2C\u0B3E\u0B1C\u0BBE\u0B30 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F AGMARKNET \u0B30\u0BC1 \u0B07\u0B07\u0D35\u0BBF\u0D1A\u0BFF\u0B24 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F, \u0B2C\u0BBE\u0B38\u0D4D\u0D25\u0BBE\u0B15\u0D3E\u0B32\u0D3F\u0D15 \u0BA8\u0BC1\u0B39\u0BC7\u0B02\u0D1C\u0BF0\u0B40 \u0B2A\u0BBE\u0B17 \u0D24\u0B25\u0D4D\u0D25\u0BCD\u0D2F Open-Meteo \u0B30\u0BC1\u0B28\u0D4D\u0D39\u0D47\u0B03\u0B39\u0D47\u0B1C\u0BBF\u0B26\u0D3F \u0B07\u0B07\u0D35\u0BBF\u0D1A\u0BFF\u0B24"
    },
    "footer": {
      "disclaimer": "\u0B15\u0BC3\u0B37\u0B3F \u0B38\u0B3E\u0B25\u0B40 \u0B15\u0BC3\u0B37\u0B3F \u0B28\u0BFF\u0B30\u0D4D\u0D23\u0BAF \u0B38\u0B39\u0B3E\u0B2F\u0B24\u0B3E \u0B2A\u0BBE\u0B39\u0BF3\u0D3F\u0B2F\u0BBE \u0B2F\u0B4B\u0B1C\u0BBE\u0B28\u0BBE \u0B2A\u0D4D\u0D30\u0B4B\u0D1F\u0D4B\u0D1F\u0BBE\u0D07\u0B2A\u0D4D\u0D2E\u0BCD \u0B05\u0B28\u0D4D\u0D24\u0B30\u0B3E\u0B17\u0D24 \u0B2E\u0D3E\u0D27\u0D4D\u0D2F\u0D02 \u0B38\u0B39\u0B3E\u0B2F\u0B24\u0B3E \u0B0F\u0B39\u0BBE \u0B1A\u0BFF\u0B15\u0BFF\u0D24\u0D4D\u0D38\u0BBE \u0B2C\u0BBE \u0B2E\u0BBE\u0BA8\u0B38\u0BFF\u0B15 \u0B30\u0D4B\u0D17 \u0B28\u0BFF\u0B30\u0D4D\u0D23\u0BAF \u0B2A\u0BCD\u0B30\u0B26\u0BBE\u0BA8 \u0B15\u0BB0\u0BC7 \u0BA8\u0BBE\u0B39\u0BFF\u0D1E\u0BCD\u0D3E",
      "dataNote": "\u0B2C\u0B3E\u0B1C\u0BBE\u0B30 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F \u0B21\u0BBE\u0D1F\u0BBE\u0B38\u0D47\u0D1F\u0D4D \u0B06\u0B27\u0BBE\u0B30\u0BFF\u0D24 \u0B30\u0BC7\u0D2B\u0BB0\u0D47\u0BA8\u0D4D\u0D38 \u0B2E\u0BC2\u0B32\u0D4D\u0D2F, \u0B2C\u0BBE\u0B38\u0D4D\u0D25\u0BBE\u0B15\u0D3E\u0B32\u0D3F\u0D15 \u0BA8\u0BC1\u0B39\u0BC7\u0B02\u0D1C\u0BF0\u0B40 \u0BA8\u0BC1\u0B39\u0BC7\u0B02\u0D1C\u0BF0\u0B3F\u0D39\u0BF0\u0BC1\u0B28\u0D4D\u0D39\u0D47\u0B03 \u0B2A\u0BBE\u0B17 \u0D24\u0B25\u0D4D\u0D25\u0BCD\u0D2F Open-Meteo API \u0B30\u0BC1\u0B28\u0D4D\u0D39\u0D47\u0B03\u0B39\u0D47\u0B1C\u0BBF\u0B26\u0D3F"
